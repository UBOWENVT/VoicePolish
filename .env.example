# Project-level environment variables for docker-compose variable substitution.
# Copy to `.env` and customize. This template file is committed; the .env you
# create from it is NOT (see .gitignore).

# Grafana admin password. Used by the grafana service in docker-compose.yml.
# Pick a strong password before bringing up the stack in any networked context.
GRAFANA_ADMIN_PASSWORD=changeme
